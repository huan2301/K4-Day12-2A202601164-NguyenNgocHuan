# Bổ sung đủ các mục còn thiếu — xem tests/test_cp2.py để biết yêu cầu.

# --- Git & Version Control ---
.git
.gitignore
.github

# --- Docker & CI/CD Files ---
.dockerignore
Dockerfile*
docker-compose*.yml

# --- Environment & Secret Files ---
.env
.env.*
*.env

